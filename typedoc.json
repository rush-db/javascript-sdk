{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.node.ts"
  ],
  "tsconfig": "tsconfig.json",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "out": "docs-reference",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "cleanOutputDir": true,
  "gitRevision": "main",
  "hideGenerator": true,
  "skipErrorChecking": true
}
