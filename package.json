{
  "name": "@rushdb/javascript-sdk",
  "description": "RushDB JavaScript SDK — memory layer for AI agents and modern apps",
  "keywords": [
    "rushdb",
    "database",
    "graph database",
    "graph-database",
    "ai memory",
    "ai-memory",
    "agent memory",
    "agent-memory",
    "memory layer",
    "memory-layer",
    "ai agents",
    "ai-agents",
    "llm memory",
    "llm-memory",
    "mcp",
    "vector search",
    "vector-search",
    "rag",
    "embedding",
    "embeddings",
    "knowledge graph",
    "knowledge-graph",
    "json normalization",
    "json-normalization",
    "schema-less",
    "schemaless",
    "no-schema",
    "self-hosted",
    "rest api",
    "rest-api",
    "graph",
    "relationships",
    "persistence",
    "rush-db"
  ],
  "license": "Apache-2.0",
  "version": "3.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.worker.d.ts",
  "scripts": {
    "build": "pnpm clean && pnpm build:package && pnpm build:types",
    "build:package": "node esbuild.config.cjs",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "types:check": "tsc --noEmit",
    "docs:reference": "typedoc",
    "clean": "rm -rf ./dist ./node_modules/.cache ./coverage ./esm ./cjs ./types",
    "flush": "rm -rf node_modules",
    "lint:circularDeps": "madge --circular ./src/*",
    "lint:circularDepsWithImage": "madge --image graph.svg --circular ./src/*",
    "test": "vitest run",
    "prepack": "pnpm build",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^20.17.23",
    "dotenv": "^16.0.3",
    "esbuild": "0.21.5",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "5.7.2",
    "vitest": "^1.6.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/rush-db/javascript-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rush-db/javascript-sdk.git"
  },
  "homepage": "https://github.com/rush-db/javascript-sdk#readme",
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.node.d.ts",
      "node": {
        "import": "./dist/index.node.mjs",
        "require": "./dist/index.cjs"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
